{
  "info": {
    "_postman_id": "c3258219-8d81-4853-a41f-b55cd33fb859",
    "name": "PORTIQA Portfolio Analysis API",
    "description": "Bearer-authenticated examples for POST /evaluate. Set api_key locally; this collection contains no credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://portiqa.ai",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Evaluate portfolio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('JSON response', function () { pm.response.to.be.json; });",
              "pm.test('Versioned evaluation envelope', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.ok).to.eql(true);",
              "  pm.expect(body.evaluation).to.be.an('object');",
              "  pm.expect(body.evaluation.engine_version).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"risk_level\": \"medium\",\n  \"cash_balance\": 5000,\n  \"positions\": [\n    {\"ticker\": \"AAPL\", \"market_value\": 25000},\n    {\"ticker\": \"MSFT\", \"market_value\": 22000},\n    {\"ticker\": \"NVDA\", \"market_value\": 8000}\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/evaluate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "evaluate"
          ]
        },
        "description": "Returns a versioned portfolio evaluation with scores, coverage, diagnostics, insights, and suggestions."
      },
      "response": [
        {
          "name": "Successful evaluation (sanitized example)",
          "originalRequest": {
